APP_NAME=NestCrafters
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8011
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_SHELL_PREVIEWS=true

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nestcrafters_local
DB_USERNAME=nestcrafters_local
DB_PASSWORD=

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=nestcrafters_m2_legacy
LEGACY_DB_USERNAME=nestcrafters_stage
LEGACY_DB_PASSWORD=

# Optional, dedicated disposable MySQL test schemas. Never use real records here.
M2_TEST_USERNAME=
M2_TEST_PASSWORD=

REGISTRATION_ENABLED=true
REGISTRATION_ADMIN_MAIL=true
# Local arithmetic/honeypot/time fallback; public deployment requires Turnstile.
REGISTRATION_BOT_DRIVER=challenge
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=nestcrafters_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=private
# Optional local-only override for disposable visual-review fixtures.
PRIVATE_STORAGE_ROOT=
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Captured in storage/logs/mail.log; no external delivery.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS=hello@nestcrafters.test
MAIL_FROM_NAME="${APP_NAME}"

# Hosting: use MAIL_MAILER=brevo with a Brevo API key (not an SMTP key).
# Local/testing intentionally rejects external mail.
BREVO_API_KEY=

# Optional loopback Mailpit, after installing it locally.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

VITE_APP_NAME="${APP_NAME}"

# M6 business mail is opt-in. Local/testing permits only log/array transports.
NESTCRAFTERS_BUSINESS_NOTIFICATIONS=false
NESTCRAFTERS_NOTIFICATION_INBOX=true
NOTIFY_CONTRACTOR_PROFILE_CHANGED=true
NOTIFY_CONTRACTOR_APPROVAL_CHANGED=true
NOTIFY_JOB_ASSIGNED=true
NOTIFY_JOB_UPDATED=true
NOTIFY_JOB_ACCEPTED=true
NOTIFY_JOB_COMPLETED=true
NOTIFY_JOB_NOTE_ADDED=true
NOTIFY_JOB_MEDIA_UPLOADED=true
NOTIFY_DOCUMENT_EXPIRING=true

# Hosting: migrate first, set QUEUE_CONNECTION=database, then enable background.
DB_QUEUE_TABLE=app_queue_jobs
DB_QUEUE_RETRY_AFTER=90
NESTCRAFTERS_BACKGROUND_ENABLED=false
NESTCRAFTERS_SHARED_HOST_WORKER=true
NESTCRAFTERS_INSURANCE_SCHEDULE=false
# Uses APP_TIMEZONE; confirm the business timezone before activation.
NESTCRAFTERS_INSURANCE_TIME=09:00
